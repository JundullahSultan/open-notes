<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>ورود | سیستم مدیریت دارو</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
    <link rel="stylesheet" href="/style.css" />
    <meta name="theme-color" content="#10a37f" />

    <style>
      body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        overflow: hidden;
      }
      .login-card {
        background: var(--chat-surface);
        border-radius: var(--radius-lg);
        padding: 2.5rem 2rem;
        width: 90%;
        max-width: 380px;
        border: 1px solid var(--chat-border);
        box-shadow: var(--shadow-lg);
        text-align: center;
        animation: modalIn 0.3s ease-out;
      }
      .login-icon {
        font-size: 3.5rem;
        color: var(--accent);
        margin-bottom: 0.5rem;
      }
      .login-card h2 {
        font-size: 1.4rem;
        font-weight: 600;
        margin-bottom: 1.8rem;
        background: linear-gradient(135deg, var(--heading-start) 30%, var(--accent));
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
      }
      input[type="password"] {
        width: 100%;
        background: var(--chat-card);
        border: 1px solid var(--chat-border);
        border-radius: 1.5rem;
        padding: 0.65rem 1rem;
        font-size: 0.95rem;
        color: var(--text-primary);
        margin-bottom: 1.2rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        font-family: inherit;
      }
      input[type="password"]:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
      }
      .error-msg {
        color: var(--danger);
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        padding: 0.7rem;
        border-radius: var(--radius-sm);
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }
    </style>
  </head>
  <body>

    <div id="globalLoader" class="loader-overlay">
      <div class="loader"></div>
    </div>

    <div class="login-card">
      <span class="material-symbols-outlined login-icon">admin_panel_settings</span>
      <h2>ورود به انبار داروها</h2>
      
      <% if (error) { %>
        <div class="error-msg">
          <span class="material-symbols-outlined" style="font-size: 1.2rem;">error</span>
          <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <input type="text" name="username" placeholder="نام کاربری" required autocomplete="off" />
        <input type="password" name="password" placeholder="رمز عبور" required />
        <button type="submit">تایید و ورود</button>
      </form>
    </div>

    <script>
      const loginForm = document.querySelector("form");
      const globalLoader = document.getElementById("globalLoader");

      if (loginForm && globalLoader) {
        loginForm.addEventListener("submit", () => {
          // As soon as the user clicks submit, show the loader.
          // We don't need to hide it, because the server will 
          // either redirect or reload the page for us!
          globalLoader.classList.add("active");
        });
      }
    </script>
  </body>
</html>